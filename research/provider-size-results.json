  "fixtures": {
    "official": "\nimport OpenAI from 'openai';\nimport Anthropic from '@anthropic-ai/sdk';\nimport { z } from 'zod';\nconst schema = z.object({ answer: z.string() });\nconst json = z.toJSONSchema(schema);\nexport async function askOpenAI(prompt, { apiKey, model, fetch, structured = false } = {}) {\n  const client = new OpenAI({ apiKey, fetch, maxRetries: 0 });\n  const result = await client.responses.create({ model, input: prompt, ...(structured ? {text: {format: {type:'json_schema',name:'answer',strict:true,schema:json}}} : {}) });\n  if (result.status !== 'completed') throw new Error('Incomplete OpenAI response');\n  return structured ? schema.parse(JSON.parse(result.output_text)) : result.output_text;\n}\nexport async function askAnthropic(prompt, { apiKey, model, fetch, structured = false } = {}) {\n  const client = new Anthropic({ apiKey, fetch, maxRetries: 0 });\n  const result = await client.messages.create({ model, max_tokens: 256, messages: [{role:'user',content:prompt}], ...(structured ? {output_config: {format: {type:'json_schema',schema:json}}} : {}) });\n  if (result.stop_reason !== 'end_turn') throw new Error('Incomplete Anthropic response');\n  const text = result.content.filter(block => block.type === 'text').map(block => block.text).join('');\n  return structured ? schema.parse(JSON.parse(text)) : text;\n}\n",
    "vercel": "\nimport { generateText, Output } from 'ai';\nimport { createOpenAI } from '@ai-sdk/openai';\nimport { createAnthropic } from '@ai-sdk/anthropic';\nimport { z } from 'zod';\nconst schema = z.object({ answer: z.string() });\nasync function execute(model, prompt, structured) {\n  const result = await generateText({ model, prompt, maxOutputTokens: 256, maxRetries: 0, ...(structured ? {output: Output.object({schema})} : {}) });\n  return structured ? result.output : result.text;\n}\nexport function askOpenAI(prompt, { apiKey, model, fetch, structured = false } = {}) {\n  return execute(createOpenAI({apiKey,fetch})(model), prompt, structured);\n}\nexport function askAnthropic(prompt, { apiKey, model, fetch, structured = false } = {}) {\n  return execute(createAnthropic({apiKey,fetch})(model), prompt, structured);\n}\n"
  },
